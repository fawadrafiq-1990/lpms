# LPMS Environment Configuration
# Copy this file to .env and update with your values
# IMPORTANT: Change all default passwords before production use!

# ===========================================
# APPLICATION
# ===========================================
SPRING_PROFILES_ACTIVE=dev
BACKEND_PORT=9874
SERVER_PORT=8080
SPRING_APPLICATION_NAME=lpms-backend

# ===========================================
# DATABASE (MySQL) - CHANGE PASSWORDS!
# ===========================================
MYSQL_ROOT_PASSWORD=CHANGE_ME_GENERATE_SECURE_PASSWORD
MYSQL_DATABASE=lpms_production
MYSQL_USER=lpms_user
MYSQL_PASSWORD=CHANGE_ME_GENERATE_SECURE_PASSWORD
MYSQL_HOST=localhost
MYSQL_PORT=3306

# JDBC Connection
SPRING_DATASOURCE_URL=jdbc:mysql://${MYSQL_HOST}:${MYSQL_PORT}/${MYSQL_DATABASE}?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=${MYSQL_USER}
SPRING_DATASOURCE_PASSWORD=${MYSQL_PASSWORD}
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=20
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=5
SPRING_DATASOURCE_HIKARI_CONNECTION_TIMEOUT=30000

# Flyway Migrations
SPRING_FLYWAY_ENABLED=true
SPRING_FLYWAY_BASELINE_ON_MIGRATE=true

# ===========================================
# JWT SECURITY - GENERATE YOUR OWN SECRET!
# ===========================================
# Generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_GENERATE_256_BIT_SECRET_KEY_MINIMUM_32_CHARS
JWT_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=86400000

# ===========================================
# REDIS
# ===========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
SPRING_REDIS_HOST=${REDIS_HOST}
SPRING_REDIS_PORT=${REDIS_PORT}
SPRING_REDIS_PASSWORD=${REDIS_PASSWORD}

# ===========================================
# KAFKA
# ===========================================
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SPRING_KAFKA_BOOTSTRAP_SERVERS=${KAFKA_BOOTSTRAP_SERVERS}
SPRING_KAFKA_CONSUMER_GROUP_ID=lpms-consumer

# ===========================================
# ELASTICSEARCH
# ===========================================
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
SPRING_DATA_ELASTICSEARCH_CLIENT_URI=http://${ELASTICSEARCH_HOST}:${ELASTICSEARCH_PORT}

# ===========================================
# OLLAMA (AI)
# ===========================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
AI_PROVIDER=ollama

# ===========================================
# CORS
# ===========================================
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_ALLOWED_HEADERS=*
CORS_ALLOW_CREDENTIALS=true

# ===========================================
# RATE LIMITING
# ===========================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_BURST_CAPACITY=150

# ===========================================
# FILE UPLOAD
# ===========================================
FILE_UPLOAD_MAX_SIZE=52428800
FILE_UPLOAD_MAX_FILE_SIZE=52428800
DOCUMENT_STORAGE_PATH=/data/documents
UPLOAD_STORAGE_PATH=/data/uploads

# ===========================================
# EMAIL (Optional)
# ===========================================
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ===========================================
# MONITORING
# ===========================================
MANAGEMENT_ENDPOINT_HEALTH_ENABLED=true
MANAGEMENT_ENDPOINT_METRICS_ENABLED=true
MANAGEMENT_ENDPOINT_PROMETHEUS_ENABLED=true

# ===========================================
# LAW FIRM
# ===========================================
LAW_FIRM_ID=firm-1
